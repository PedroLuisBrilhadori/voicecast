{
  "name": "voicecast",
  "version": "0.1.0",
  "private": true,
  "description": "Sessões de contexto: voz + tela gravadas localmente, transcritas (ASR local) e transformadas em referências para agentes de código.",
  "main": "dist/main/index.js",
  "scripts": {
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.json --noEmit",
    "build:main": "tsc -p tsconfig.node.json",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload/index.js",
    "build:renderer": "vite build",
    "build": "pnpm build:main && pnpm build:preload && pnpm build:renderer",
    "dev:win": "pnpm --silent build && powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/sync-to-host.ps1 -Run",
    "test": "vitest run",
    "ci:local": "pnpm typecheck && pnpm test && pnpm build"
  },
  "packageManager": "pnpm@10.18.0",
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4",
    "electron": "^44.4.3",
    "esbuild": "^0.25",
    "typescript": "^5.8",
    "vite": "^6",
    "vitest": "^3"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "koffi": "^3.3.1",
    "react": "^19",
    "react-dom": "^19.2.7"
  }
}
