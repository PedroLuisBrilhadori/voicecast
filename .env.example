# voicecast — optional environment variables (copy to .env if needed)
# No secrets are required to run: the app is 100% local.

# Host of the embedded ASR service (default: http://127.0.0.1:8701)
# VOICECAST_ASR_HOST=1

# 0 turns off the ASR host (the GPU is freed; transcription becomes unavailable)
# VOICECAST_ASR_HOST=0

# OTel telemetry (OTLP HTTP exporter; optional)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# Jev gate smoke test (requires TYPESAFE_API_KEY — NEVER commit the real key)
# TYPESAFE_API_KEY=
