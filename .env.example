# voicecast — variáveis de ambiente opcionais (copie para .env se precisar)
# Nenhum segredo é necessário para rodar: o app é 100% local.

# Host do serviço ASR embutido (default: http://127.0.0.1:8701)
# VOICECAST_ASR_HOST=1

# 0 desliga o host do ASR (a GPU fica livre; a transcrição fica indisponível)
# VOICECAST_ASR_HOST=0

# Telemetria OTel (exportador OTLP HTTP; opcional)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# Smoke test do gate Jev (requer TYPESAFE_API_KEY — NUNCA comite a key real)
# TYPESAFE_API_KEY=
